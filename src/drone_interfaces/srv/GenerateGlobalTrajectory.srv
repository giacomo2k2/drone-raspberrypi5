# Request
geometry_msgs/Point[] waypoints        # Waypoints to fly through
float64 vmax                           # Maximum allowed velocity
float64 amax                           # Maximum allowed acceleration
uint32 order                            # Polynomial order (optional)
uint32 continuity_order                 # Continuity constraints (optional)
uint32 min_derivative_order             # Min derivative for QP (optional)
---
# Response
bool success                            # True if trajectory generation succeeded
string message                          # Error/debug message

# Coefficients: arrays of arrays flattened into 1D for ROS
float64[] coeffs_x                      # coeffs_x = [seg0_order0, seg0_order1, ..., seg1_order0, ...]
float64[] coeffs_y
float64[] coeffs_z
uint32 num_segments                       # Number of segments
uint32 num_coeffs_segment                 # Number of coefficients per segment (order+1)
float64[] periods
