# FollowTrajectory.action

# ===== GOAL =====
geometry_msgs/Point[] waypoints    # Waypoints to follow
float64[] hold_times               # How long to hold at each waypoint (seconds)
uint32[] hold_indexes              # Index of the waypoint to hold at
bool use_camera                     

---
# ===== RESULT =====
bool success                       # True if trajectory executed successfully
string message                     # Optional debug message

---
# ===== FEEDBACK =====
string segment_type                 # Current segment type
geometry_msgs/Point current_point   # Current drone position
geometry_msgs/Point setpoint        # Sent setpoint
uint32 current_major_segment         # Index of current trajectory segment
uint32 current_minor_segment         # Index of current trajectory segment
float64 local_progress              # Progress along current segment (0.0 - 1.0)
float64 global_progress             # Progress along trajectory (0.0 - 1.0)
float64 deviation                   # Deviation from trajectory (Euclidean)
